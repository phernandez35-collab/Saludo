@page "/letrero"
@rendermode InteractiveServer

<div class="alert alert-info">
    <h2>@Mensaje</h2>
</div>
<div class="alert alert-info">
    <p>Edad : @Edad</p>
    <p>Fecha: @Fecha.ToLongDateString()</p>
    <p>Boleano: @Bandera.ToString()</p>
</div>

<div class="row mb-3">
    <div class="col -6">
        <input class="form-control" @bind="Nombre"/>
    </div>
</div>

<div class="row mb-3">
    <div class="col -6">
        <input class="form-control" @bind="Numero"/>
    </div>
</div>

<button class="btn btn-primary" @onclick="Cambio">
    Ejecutar Cambio
</button>

@if (Numero >= 18)
{
    <div class="alert alert-info">
        <h2>Usted es mayor de edad</h2>
    </div>
}
else
{
    <div class="alert alert-danger">
        <h2>Usted es menor de edad</h2>
    </div>
}

<div class="alert alert-@((Numero >= 18) ? "danger" : "success")">
    <h2>Eres @((Numero >= 18) ? "mayor" : "menor") de edad</h2>
</div>

@code{
    [Parameter]
    public string? Mensaje
    {
        get; set;
    } = "Letrero";

    private int Edad = 10;
    private DateTime Fecha = DateTime.Now;
    private bool Bandera = true;
    private string Nombre = string.Empty;
    private int Numero;

