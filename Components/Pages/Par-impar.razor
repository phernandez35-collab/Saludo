@page "/par-impar"
@rendermode InteractiveServer

<div class="row mb-3">
    <div class="col-6">
        <input type="number" class="form-control" @bind="Numero" />
    </div>
</div>

<button class="btn btn-primary" @onclick="Cambio">
    Evaluar Número
</button>

@if (mostrarResultado)
{
    switch (Numero % 2)
    {
        case 0:
            <div class="alert alert-info mt-3">
                <h2>El número es par</h2>
            </div>
            break;

        default:
            <div class="alert alert-danger mt-3">
                <h2>El número es impar</h2>
            </div>
            break;
    }
}

@code {
    private int Numero;
    private bool mostrarResultado = false;

    private void Cambio()
    {
        mostrarResultado = true;
    }
}